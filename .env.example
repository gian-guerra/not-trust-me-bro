# Copy to .env and fill in what you need. .env is git-ignored.

# LLM in LiteLLM "provider/model" format. Default: local Ollama.
NTMB_LLM_MODEL=ollama/qwen3:14b

# Only needed for OpenAI models
NTMB_OPENAI_API_KEY=

# Embeddings (one Weaviate collection per model). Changing the model needs a re-ingest.
# NTMB_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunking. Changing these re-ingests documents automatically on the next ingest.
# NTMB_CHUNK_MAX_TOKENS=320
# NTMB_CHUNK_OVERLAP_TOKENS=75
# NTMB_CHUNK_MIN_TOKENS=65
